{
  "description": "personal-data guardrails: block egress/git-write/raw-DB commands inside the plugin's agents, ask before any git push, and require a STATUS/VERIFIED contract from warehouse-analyst before it returns.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py", "pretooluse"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "personal-data:warehouse-analyst|warehouse-analyst",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py", "subagentstop"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
