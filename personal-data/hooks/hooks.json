{
  "description": "personal-data guardrails: block egress/git-write/raw-DB commands inside the plugin's agents, ask before any git push, and enforce warehouse-analyst's STATUS/VERIFIED (or VERDICT) return contract at handback, with a parent-side backstop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
              "pretooluse"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
              "handback"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py",
              "agent_result"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
