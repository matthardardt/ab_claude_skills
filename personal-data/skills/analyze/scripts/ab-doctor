#!/usr/bin/env python3
"""ab-doctor — health check + self-repair for the personal-claude-skills plugin install.

Designed to run as a SessionStart hook (fast, silent when healthy, always exit 0).
Run `ab-doctor --verbose` by hand for a full report.

Checks:
  1. Every plugin recorded in ~/.claude/plugins/installed_plugins.json has a live
     installPath containing .claude-plugin/plugin.json. If the versioned cache dir
     was wiped (known failure, first hit 2026-06-29), repairs it by copying from
     the marketplace clone and prints a loud RESTART warning (skills load at startup).
  2. The marketplace clone's git HEAD matches the recorded gitCommitSha (drift warning
     only — never auto-syncs git state).
  3. ~/.claude/bin/rs and sql_guard.py exist AND match the marketplace clone's source
     byte-for-byte (rs_query.py ignoring its rewritten shebang) — a stale guard in
     ~/.claude/bin silently undoes a security fix.
  4. The knowledge layer (data dictionary + semantic catalog) exists.
  5. The last full `catalog drift` run (catalog vs the LIVE warehouse) is <= 7 days old and
     was clean. Reads a stamp file only — never queries the warehouse at session start.
"""

import json
import shutil
import time
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
PLUGINS = HOME / ".claude" / "plugins"
CLONE = PLUGINS / "marketplaces" / "personal-claude-skills"
VERBOSE = "--verbose" in sys.argv

issues, notes = [], []


def say(msg):
    if VERBOSE:
        print(msg)


def main():
    # 1. cache integrity + repair
    reg_path = PLUGINS / "installed_plugins.json"
    if not reg_path.exists():
        issues.append(f"missing {reg_path} — plugins are not registered at all")
    else:
        reg = json.loads(reg_path.read_text())
        for key, entries in reg.get("plugins", {}).items():
            plugin_name = key.split("@")[0]
            for entry in entries:
                install = Path(entry["installPath"])
                if (install / ".claude-plugin" / "plugin.json").exists():
                    say(f"ok: {key} at {install}")
                    continue
                src = CLONE / plugin_name
                if not (src / ".claude-plugin" / "plugin.json").exists():
                    issues.append(f"{key}: cache missing at {install} and no source at {src} — manual repair needed")
                    continue
                install.parent.mkdir(parents=True, exist_ok=True)
                if install.exists():
                    shutil.rmtree(install)
                shutil.copytree(src, install)
                issues.append(
                    f"{key}: cache was missing — REPAIRED from {src}. "
                    f"RESTART Claude Code: skills load at startup, this session does not have them."
                )

    # 2. clone vs recorded sha (drift note only)
    try:
        head = subprocess.run(
            ["git", "-C", str(CLONE), "rev-parse", "HEAD"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
        if reg_path.exists() and head:
            shas = {e.get("gitCommitSha") for v in reg.get("plugins", {}).values() for e in v}
            shas.discard(None)
            if shas and head not in shas:
                notes.append(
                    f"marketplace clone HEAD ({head[:8]}) != recorded install sha "
                    f"({', '.join(s[:8] for s in shas)}) — cache may be newer/older than the clone; "
                    f"re-register or rebuild the cache when convenient"
                )
    except Exception:
        pass

    # 3. runtime scripts
    src_dir = CLONE / "personal-data" / "skills" / "analyze" / "scripts"
    for f in ("rs", "sql_guard.py", "rs_query.py", "ab-doctor"):
        installed = HOME / ".claude" / "bin" / f
        if not installed.exists():
            issues.append(f"~/.claude/bin/{f} missing — run setup_env.sh from the plugin's analyze/scripts dir")
            continue
        src = src_dir / f
        if not src.exists():
            continue
        a, b = installed.read_bytes(), src.read_bytes()
        if f == "rs_query.py":
            a, b = a.split(b"\n", 1)[-1], b.split(b"\n", 1)[-1]
        if a != b:
            issues.append(
                f"~/.claude/bin/{f} differs from the marketplace clone — run setup_env.sh from "
                f"{src_dir} (or sync the clone first if ~/.claude/bin is the newer one)"
            )

    # 4. knowledge layer
    for p in ("actblue-data-dictionary.md", "actblue-semantic-catalog"):
        if not (HOME / ".claude" / p).exists():
            issues.append(f"~/.claude/{p} missing — knowledge layer broken; restore from the ~/.claude git history")

    # 5. live drift recency (stamp written by catalog_drift.py after a full run)
    stamp = HOME / ".claude" / "actblue-semantic-catalog" / ".last_drift"
    try:
        ts, n_findings = stamp.read_text().split()[:2]
        age_days = (time.time() - float(ts)) / 86400
        if int(n_findings):
            notes.append(f"last `catalog drift` found {n_findings} finding(s) — fix in _staging/ and rebuild")
        elif age_days > 7:
            notes.append(f"`catalog drift` last ran {age_days:.0f} days ago — run `~/.claude/actblue-semantic-catalog/bin/catalog drift` (VPN, ~5 min)")
        else:
            say(f"ok: catalog drift clean {age_days:.1f} days ago")
    except (OSError, ValueError):
        notes.append("`catalog drift` has never recorded a full run — run `~/.claude/actblue-semantic-catalog/bin/catalog drift` (VPN, ~5 min)")

    for n in notes:
        print(f"ab-doctor note: {n}")
    for i in issues:
        print(f"ab-doctor: {i}")
    if VERBOSE and not issues and not notes:
        print("ab-doctor: all healthy")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # a broken doctor must never break session start
        print(f"ab-doctor: internal error ({e}) — run with --verbose to debug")
    sys.exit(0)
