#!/bin/bash
# rs — read-only Redshift access for the personal-data:analyze skill.
#
# Enforces: SELECT-only statements, single statement per call, statement timeout,
# row cap on table output. Credentials come from REDSHIFT_* env vars, falling back
# to the `export REDSHIFT_*` lines in ~/.zshrc.
#
# Usage:
#   rs sql  "<query>"              run query, aligned table output (LIMIT 500 appended if absent)
#   rs csv  "<query>" <out.csv>    run query, full results to CSV (no row cap)
#   rs find <pattern>              search table/view names across schemas
#   rs cols <schema.table>         list columns and types
#   rs peek <schema.table>         first 10 rows
#   rs explain "<query>"           query plan without executing
#   rs check "<query>"             validate read-only rules only, no connection
#   rs ping                        connectivity test (select 1)
set -euo pipefail

TIMEOUT_MS="${RS_TIMEOUT_MS:-300000}"   # 5 min default statement timeout
ROW_CAP="${RS_ROW_CAP:-500}"            # row cap for `rs sql` table output

die() { echo "rs: $*" >&2; exit 2; }

load_creds() {
    if [ -z "${REDSHIFT_HOST:-}" ] || [ -z "${REDSHIFT_PASSWORD:-}" ]; then
        # shellcheck disable=SC1090
        eval "$(grep -E '^export REDSHIFT_(HOST|PORT|DB|USERNAME|PASSWORD)=' "$HOME/.zshrc" 2>/dev/null || true)"
    fi
    [ -n "${REDSHIFT_HOST:-}" ]     || die "REDSHIFT_HOST not set (expected in env or ~/.zshrc)"
    [ -n "${REDSHIFT_PORT:-}" ]     || die "REDSHIFT_PORT not set"
    [ -n "${REDSHIFT_DB:-}" ]       || die "REDSHIFT_DB not set"
    [ -n "${REDSHIFT_USERNAME:-}" ] || die "REDSHIFT_USERNAME not set"
    [ -n "${REDSHIFT_PASSWORD:-}" ] || die "REDSHIFT_PASSWORD not set"
}

# Strip string literals and SQL comments so keyword checks can't be fooled or
# false-positived by literals like where action = 'delete'.
normalize() {
    printf '%s' "$1" \
        | sed -E "s/'[^']*'/''/g" \
        | sed -E 's/--[^\r\n]*//g' \
        | sed -E 's:/\*[^*]*\*+([^/*][^*]*\*+)*/: :g' \
        | tr '[:upper:]' '[:lower:]'
}

validate_readonly() {
    local raw="$1" norm first
    norm=$(normalize "$raw")

    first=$(printf '%s' "$norm" | grep -oE '[a-z_]+' | head -1)
    case "$first" in
        select|with|explain|show) ;;
        *) die "blocked — statement must start with SELECT/WITH/EXPLAIN/SHOW (got: ${first:-empty})" ;;
    esac

    if printf '%s' "$norm" | grep -qwE 'insert|update|delete|drop|create|alter|truncate|grant|revoke|copy|unload|merge|call|vacuum|into|set|begin|commit|rollback|lock|comment'; then
        die "blocked — write/DDL keyword detected (read-only access only)"
    fi

    # Single statement: reject any semicolon that isn't trailing.
    if printf '%s' "$norm" | sed -E 's/;[[:space:]]*$//' | grep -q ';'; then
        die "blocked — multiple statements not allowed"
    fi
}

run_psql() {
    # $1 = query, remaining args passed through to psql (e.g. --csv, -t)
    local query="$1"; shift
    PGPASSWORD="$REDSHIFT_PASSWORD" PGCONNECT_TIMEOUT=10 psql \
        -h "$REDSHIFT_HOST" -p "$REDSHIFT_PORT" -U "$REDSHIFT_USERNAME" -d "$REDSHIFT_DB" \
        -X -q -v ON_ERROR_STOP=1 \
        -c "set statement_timeout to ${TIMEOUT_MS}" \
        -c "$query" "$@" \
        || die "query failed — if this was a connection timeout, check that you are on the AB VPN"
}

MODE="${1:-}"; [ -n "$MODE" ] || die "usage: rs {sql|csv|find|cols|peek|explain|check|ping} ..."
shift

case "$MODE" in
    check)
        Q="${1:?usage: rs check \"<query>\"}"
        validate_readonly "$Q"
        echo "rs: OK — passes read-only validation"
        ;;
    ping)
        load_creds
        run_psql "select 1 as connected" -tA
        ;;
    sql)
        Q="${1:?usage: rs sql \"<query>\"}"
        validate_readonly "$Q"
        load_creds
        if ! normalize "$Q" | grep -qwE 'limit'; then
            Q="$(printf '%s' "$Q" | sed -E 's/;[[:space:]]*$//') limit ${ROW_CAP}"
        fi
        run_psql "$Q"
        ;;
    csv)
        Q="${1:?usage: rs csv \"<query>\" <out.csv>}"
        OUT="${2:?usage: rs csv \"<query>\" <out.csv>}"
        validate_readonly "$Q"
        load_creds
        run_psql "$Q" --csv > "$OUT"
        echo "rs: wrote $(($(wc -l < "$OUT") - 1)) rows to $OUT"
        ;;
    explain)
        Q="${1:?usage: rs explain \"<query>\"}"
        validate_readonly "$Q"
        load_creds
        run_psql "explain $(printf '%s' "$Q" | sed -E 's/;[[:space:]]*$//')"
        ;;
    find)
        P="${1:?usage: rs find <pattern>}"
        case "$P" in *\'*) die "invalid pattern" ;; esac
        load_creds
        run_psql "select table_schema, table_name, table_type from svv_tables where table_name ilike '%${P}%' and table_schema not in ('pg_catalog', 'information_schema') order by table_schema, table_name limit 100"
        ;;
    cols)
        T="${1:?usage: rs cols <schema.table>}"
        case "$T" in *\'*) die "invalid table name" ;; esac
        SCHEMA="${T%%.*}"; TABLE="${T#*.}"
        [ "$SCHEMA" != "$TABLE" ] || die "table must be schema-qualified: schema.table"
        load_creds
        run_psql "select column_name, data_type, is_nullable from svv_columns where table_schema = '${SCHEMA}' and table_name = '${TABLE}' order by ordinal_position"
        ;;
    peek)
        T="${1:?usage: rs peek <schema.table>}"
        printf '%s' "$T" | grep -qE '^[a-z0-9_]+\.[a-z0-9_]+$' || die "invalid table name (expected schema.table)"
        load_creds
        run_psql "select * from ${T} limit 10"
        ;;
    *)
        die "unknown mode: $MODE (expected sql|csv|find|cols|peek|explain|check|ping)"
        ;;
esac
